# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/*
!.claude/state/*.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
/.quarto/
paper/.quarto/
paper/quarto/*_files/
paper/quarto/.quarto/
_output/

# Output artifacts
docs/

# Generated HTML reports
project_dashboard.html
quality_reports/**/*.html

# ── Large data files (gitignored — download from HuggingFace or regenerate) ──

# BERTopic notebook outputs (large CSVs — HuggingFace: patrickjcrawford/civil-war-news)
data/cleaned/bertopic_panel_*.csv
data/cleaned/bertopic_results_*.csv
data/cleaned/sentiment_results.csv

# Cleaned panels (regenerate with 01_build_panel.R)
data/cleaned/*.rds

# Raw large files
data/raw/*.npy
data/raw/news_proc.zip
data/raw/news_proc/
data/raw/americanstories_civilwar.zip
data/raw/americanstories_civilwar/
data/raw/news_filt/
data/raw/news_model_sub/
data/raw/sent_df_sub.csv
data/raw/sentiment_df_sub.csv
data/raw/top2vec_df_sub_NEW.csv
data/raw/top2vec_df_all_sub.csv
data/raw/top2vec_reduced_*.csv

# GIS shapefiles (large — download from NHGIS / ICPSR)
data/raw/gis/
